# FAIR QuickRisk — Apache configuration for ~/public_html/quickrisk/
#
# Deployed alongside the compiled React assets and the PHP API. This file must not
# contain secrets and must never be served as content.

Options -Indexes
DirectoryIndex index.html

# ---------------------------------------------------------------------------
# RFC 8615 /.well-known — public by design, never gated.
#
# Let's Encrypt / cPanel AutoSSL validates HTTP-01 by fetching
# /.well-known/acme-challenge/<token> directly from this origin, without the
# Cloudflare header, so this path must pass the origin gate below. Blocking it
# would break certificate renewal and take the site offline when the current
# certificate expires. The same applies to pki-validation/ for third-party CAs
# and to discovery documents such as /.well-known/security.txt.
#
# Deliberately narrow: GET or HEAD only, one safe path segment, first character
# alphanumeric so "." and ".." can never match, no directory listing
# (Options -Indexes above). It sits BEFORE the gate so that renewal also works
# while the gate is in its fail-closed (unrendered) state.
#
# The rule pattern is matched relative to the directory holding this file, so it
# works whether the application is served at the domain root or a subdirectory.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
    RewriteRule ^\.well-known/(?:(?:acme-challenge|pki-validation)/)?[A-Za-z0-9_-][A-Za-z0-9._-]{0,127}$ - [L]
</IfModule>

# ---------------------------------------------------------------------------
# ALWAYS-ON: origin access gate (Cloudflare -> origin).
#
# Every request must arrive from Cloudflare carrying the shared X-Origin-Secret
# header; anything else is refused. The real rule is rendered by
# tools/render-apache-policy.php from ~/quickrisk-config/cloudflare-origin-secret
# (or QK_ORIGIN_SECRET). The value is never versioned and never appears in any
# file in this repository.
#
# The block below is FAIL-CLOSED as committed: it refuses everything until the
# renderer replaces it. That is deliberate. A copy of this file that escapes the
# pipeline (manual upload, rsync) must lock the site, not open it. Never soften
# this stub into a matchable placeholder: this repository is public, so any
# committed header value would be a known bypass.
#
# The REDIRECT_STATUS condition keeps the denial out of Apache's internal
# subrequests. ErrorDocument serves the branded page (/errors/403.html) through
# an internal redirect, and a subrequest cannot carry anything the client did
# not already send. Without this exemption a refused request is answered by
# Apache's bare "Additionally, a 403 Forbidden error was encountered while
# trying to use an ErrorDocument" page instead of ours, which is exactly what a
# visitor of a gated origin or a mistyped URL used to see. REDIRECT_STATUS is
# set by Apache itself during an internal redirect, so a client cannot forge it,
# and the gate still refuses every top-level request that lacks the header.
#
# Requirement: requirements/QuickRisk_Cloudflare_Origin_Gate_Requirements.md
# ---------------------------------------------------------------------------
# >>> QK-ORIGIN-GATE-BEGIN
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Fail-closed stub. Replaced at deploy time with the X-Origin-Secret check.
    RewriteCond %{ENV:REDIRECT_STATUS} ^$
    RewriteRule ^874fc44e4030f0eb01d72c5bae7848ef956d9e536aaf7e757d0c61c0b7b73a91- [F,L]
</IfModule>
# <<< QK-ORIGIN-GATE-END

# ---------------------------------------------------------------------------
# Error documents: static pages delivered with the build
# (frontend/public/errors/), styled with the application's design tokens.
# Paths are domain-root relative; if the application is ever published under a
# subdirectory, that prefix must be added to each path (see
# static-pages/README.md for the same rule). While
# ~/quickrisk-config/beta-gate.htaccess exists it appends its own
# ErrorDocument 403, which wins for as long as the holding notice is in use.
# ---------------------------------------------------------------------------
ErrorDocument 403 /errors/403.html
ErrorDocument 404 /errors/404.html
ErrorDocument 500 /errors/500.html
ErrorDocument 503 /errors/503.html

# ---------------------------------------------------------------------------
# Never serve model files, configuration, source, maps or development artefacts.
# The authoritative model lives outside the web root; these rules are defence in
# depth in case a copy is ever placed here by mistake.
# ---------------------------------------------------------------------------
<FilesMatch "\.(json|md|map|ts|tsx|jsx|lock|log|bak|sql|yml|yaml|ini|env|dist)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# Security headers.
#
# They are defined here rather than in the virtual host because the application is served
# by shared hosting with no apache.conf access. `Header` only needs AllowOverride to
# include FileInfo, which live/share/.htaccess requires anyway, so any host that serves
# the share links correctly also applies everything below. Verify from anywhere with:
#
#   curl -sI https://HOST/ | grep -i 'content-security-policy'
#
# `always` stamps error responses too, so even the 403 holding notice carries them.
#
# The policy is the one written in includes/security_headers.php; tests/security_headers.test.php
# compares the two directive lists, so a change must be made in both places.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    Header always set X-Permitted-Cross-Domain-Policies "none"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # Same-origin only. The pages call their own JSON endpoints, so no cross-origin read
    # is ever granted. `unset` also removes a permissive header inherited from a parent
    # policy, a provider default vhost or an earlier .htaccess in the same tree; leaving
    # `Access-Control-Allow-Origin: *` in place would let any third-party page read the
    # responses that this origin serves without authentication.
    Header always unset Access-Control-Allow-Origin
    Header always unset Access-Control-Allow-Methods
    Header always unset Access-Control-Allow-Headers
    Header always unset Access-Control-Allow-Credentials
    Header always unset Access-Control-Expose-Headers
    Header always unset Access-Control-Max-Age

    # The policy the application needs, in one header with one style directive. A second
    # policy header — from a child .htaccess or a <meta http-equiv> tag — is enforced in
    # addition to this one, so it can only make the page stricter, never relax it.
    #
    #   script-src  'self'            the build is a single external module, no inline code
    #   style-src   'self' + hashes   no inline keyword is allowed: the static documents
    #                                 (methodology, the branded error pages, the holding
    #                                 notice) style themselves with one inline <style> block
    #                                 each, allowed by its sha256. tools/render-apache-policy.php
    #                                 computes those hashes from the files it is about to
    #                                 publish, so the values below are a fallback for a
    #                                 manual copy.
    #   img-src     data:             inline SVG and data URIs in the charts
    #   connect-src 'self'            QuickRisk Live and Decision Lab same-origin JSON APIs
    #   frame/object/child 'none'     nothing is embedded and no plugin content is loaded
    #   frame-ancestors 'none'        cannot be expressed in a <meta> tag at all
    #   form-action 'self'            stated explicitly: it has no fallback directive
    #   base-uri    'self'            no <base> tag can retarget relative URLs
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'sha256-Lg4WFrcK9kjeRs8LDXjPQAaeooAmmysE1Y0BZM7wpBI=' 'sha256-WF7buxXEshblQVVTUx1RDs+RjeA3bdwWOZi1hUZAu9U=' 'sha256-rwphtFjau7AFUxYhXuH9NNjMw2I/1skWcSeIG/HDvAs='; img-src 'self' data:; font-src 'self'; connect-src 'self'; media-src 'none'; object-src 'none'; frame-src 'none'; child-src 'none'; worker-src 'none'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

    # Safe on this host: includeSubDomains covers only *.quickrisk.iliadis.net, and every
    # name below that domain is served over HTTPS. One year is the minimum browsers accept
    # for preload, and the deployment verifier refuses anything shorter — in particular an
    # edge value of max-age=0, which disables transport security for returning visitors.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ---------------------------------------------------------------------------
# Caching: versioned static assets may be cached; HTML and API responses must not
# be cached, because a calculation response must never be reused from a cache.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|svg|png|jpe?g|webp|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|xml|txt)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
# No SPA rewrite rule is defined on purpose for the QuickRisk application: it is a single
# index.html with in-memory views, so there are no client-side routes to fall back from.
# This also guarantees that /api/calculate.php is never rewritten by the root.
#
# QuickRisk Live adds exactly one rewrite and scopes it to its own directory:
# live/share/.htaccess maps /live/share/{opaqueToken} onto the static share shell. It cannot
# affect /api/calculate.php or any other path.

# Compress text assets where mod_deflate is available.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
# The temporary beta access gate is appended BELOW this line by tools/deploy.sh,
# from ~/quickrisk-config/beta-gate.htaccess.
#
# It is never versioned: it holds real addresses and is rewritten whenever the office
# DDNS address changes. While that file exists the site answers 403 with the holding
# notice to every address that is not listed. Delete the file and redeploy to open the
# site to the public.
# ---------------------------------------------------------------------------
